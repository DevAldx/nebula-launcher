{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nebula Launcher",
  "version": "0.1.7",
  "identifier": "dev.nebula.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nebula Launcher",
        "width": 1100,
        "height": 680,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://textures.minecraft.net; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxMUM1NTdGMURDNDk4RDIKUldUU21NUWRmMVVjTWViSFMwSUwyNDRaazBZczM4dVMwR3dNMmdPankxckRDN0phTXBZNkl3eE8K",
      "endpoints": [
        "https://github.com/DevAldx/nebula-launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
